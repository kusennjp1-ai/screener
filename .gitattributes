
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Tooling and workflow fixtures include exact byte hashes and LF boundaries.
# Keep checkouts identical on Windows and on the Linux publication runners.
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# The market-regime reference's source is pinned by its sha256 (docs/brief-and-market-environment.md):
# keep its bytes exactly as committed on every checkout.
frontend/tools/reference-sources/** -text
